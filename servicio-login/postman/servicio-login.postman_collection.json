{
  "info": {
    "name": "Servicio de login - Tienda de Abarrotes (GA7-AA5-EV01)",
    "description": "Pruebas del servicio web de registro e inicio de sesión. Mauricio Vargas - Ficha 3186699",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Verificar que el servicio está activo",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/salud",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "salud"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código de estado 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Responde ok\", () => pm.expect(pm.response.json().ok).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Registro válido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/registro",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "registro"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"{{usuarioPrueba}}\",\n  \"nombre\": \"Usuario de Prueba\",\n  \"clave\": \"{{clavePrueba}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"usuarioPrueba\", \"prueba_\" + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código de estado 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Mensaje de registro\", () => pm.expect(pm.response.json().mensaje).to.include(\"registrado\"));",
              "pm.test(\"No devuelve la contraseña\", () => pm.expect(JSON.stringify(pm.response.json())).to.not.include(pm.collectionVariables.get(\"clavePrueba\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Registro con usuario repetido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/registro",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "registro"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"{{usuarioPrueba}}\",\n  \"nombre\": \"Usuario de Prueba\",\n  \"clave\": \"{{clavePrueba}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código de estado 409\", () => pm.response.to.have.status(409));",
              "pm.test(\"Indica que ya existe\", () => pm.expect(pm.response.json().mensaje).to.include(\"ya está registrado\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Registro con datos inválidos",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/registro",
