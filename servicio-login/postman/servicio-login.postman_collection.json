          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código de estado 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Devuelve el usuario del token\", () => pm.expect(pm.response.json().usuario.usuario).to.eql(pm.collectionVariables.get(\"usuarioPrueba\")));"
            ]
          }
        }
