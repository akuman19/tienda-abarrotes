            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "registro"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"ab\",\n  \"nombre\": \"X\",\n  \"clave\": \"123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código de estado 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Devuelve 3 errores de validación\", () => pm.expect(pm.response.json().errores).to.have.lengthOf(3));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Inicio de sesión correcto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"{{usuarioPrueba}}\",\n  \"clave\": \"{{clavePrueba}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código de estado 200\", () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test(\"Autenticación satisfactoria\", () => pm.expect(r.mensaje).to.eql(\"Autenticación satisfactoria.\"));",
              "pm.test(\"Entrega un token JWT\", () => pm.expect(r.token.split(\".\")).to.have.lengthOf(3));",
              "pm.collectionVariables.set(\"token\", r.token);"
            ]
          }
        }
      ]
    },
